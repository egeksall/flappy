{
  "name": "flappy-bird-ultra",
  "version": "1.0.0",
  "description": "High-performance Flappy Bird clone built with Phaser 3 and ready for Apple App Store / Google Play via Capacitor.",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8080",
    "cap:add:ios": "npx @capacitor/cli add ios",
    "cap:sync": "npx @capacitor/cli sync",
    "cap:open:ios": "npx @capacitor/cli open ios",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:open:android": "npx @capacitor/cli open android"
  },
  "keywords": [
    "phaser3",
    "flappy-bird",
    "ios-game",
    "app-store",
    "capacitor",
    "game-dev"
  ],
  "author": "Antigravity Developer",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
