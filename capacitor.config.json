{
  "appId": "com.firedragon.game",
  "appName": "Fire Dragon",
  "webDir": ".",
  "bundledWebRuntime": false,
  "ios": {
    "scrollEnabled": false,
    "allowsLinkPreview": false,
    "contentInset": "always",
    "backgroundColor": "#0a0a14"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a0a14",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}
